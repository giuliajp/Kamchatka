# Скопируйте этот файл в backend/.env из корня репозитория и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore) — там секреты.

ENVIRONMENT=development

# PostgreSQL в Docker Compose. Команды запускайте из корня репозитория
# с параметром --env-file backend/.env.
POSTGRES_DB=avacha
POSTGRES_USER=avacha
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backend собирает адрес подключения из POSTGRES_* выше.

# С каких адресов фронтенду разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Настройки авторизации, VK и Iridium360 добавляются вместе с реализацией интеграций.
