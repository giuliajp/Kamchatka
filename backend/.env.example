# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore) — там секреты.

ENVIRONMENT=development

# Секретный ключ приложения. Локально — любой текст.
SECRET_KEY=change-me

# База данных.
# Локально — файл SQLite, ничего устанавливать не нужно (создастся backend/instance/avacha.db):
DATABASE_URL=sqlite+aiosqlite:///./instance/avacha.db
# На сервере — PostgreSQL (обратите внимание на +asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/avacha

# С каких адресов фронтенду разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

VK_APP_ID=
VK_APP_SECRET=

IRIDIUM360_API_URL=https://www.iridium360.ru
IRIDIUM360_API_KEY=

# Как часто НАШ бэкенд опрашивает Iridium360, в секундах.
# Не путать с интервалом передачи точек самим трекером (20 мин) —
# он хранится в базе, в настройках сезона и этапа.
TRACKER_POLL_INTERVAL_SECONDS=1200
