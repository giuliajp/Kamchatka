# Скопируйте этот файл в backend/.env из корня репозитория и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore) — там секреты.

ENVIRONMENT=development

# Секретный ключ приложения. Локально — любой текст.
SECRET_KEY=change-me

# PostgreSQL в Docker Compose. Команды запускайте из корня репозитория
# с параметром --env-file backend/.env.
POSTGRES_DB=avacha
POSTGRES_USER=avacha
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backend собирает адрес подключения из POSTGRES_* выше.

# С каких адресов фронтенду разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# VK: ID мини-приложения и «Защищённый ключ» (проверка подписи параметров запуска)
VK_APP_ID=
VK_APP_SECRET=
# Только локально без VK: запросы без параметров запуска — от этого пользователя.
# В production не действует. Пусто — выключено.
VK_DEV_USER_ID=

# Сколько часов действует вход организатора в админку
ADMIN_TOKEN_TTL_HOURS=12

IRIDIUM360_API_URL=https://api.iridium360.ru
IRIDIUM360_API_KEY=

# Как часто НАШ бэкенд опрашивает Iridium360, в секундах.
# Не путать с интервалом передачи точек самим трекером (20 мин) —
# он хранится в базе, в настройках сезона и этапа.
TRACKER_POLL_INTERVAL_SECONDS=120
